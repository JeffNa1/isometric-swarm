; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but the notation is fairly straightforward.

config_version=5

[application]

config/name="Isometric Swarm"
config/description="Fast-paced, absurdly outnumbered swarm survival."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.027, 0.043, 0.078, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Data="*res://scripts/data.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=600
window/size/viewport_height=600
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.043, 0.078, 1)
anti_aliasing/quality/msaa_2d=0
